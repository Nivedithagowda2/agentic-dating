# --- Required ---
GROQ_API_KEY="your_groq_api_key_here"
APIFY_TOKEN="your_apify_token_here"

PROFILE_MODEL=llama-3.3-70b-versatile
JUDGE_MODEL=llama-3.3-70b-versatile
DATE_MODEL=llama-3.1-8b-instant

# Groq's free tier rate-limits hard, so keep this low
DATE_CONCURRENCY=2

# --- Scrapers (Apify actors; verify these in the Apify Store, they change) ---
INSTAGRAM_ACTOR=apify/instagram-profile-scraper
LINKEDIN_ACTOR=dev_fusion/linkedin-profile-scraper
# Name of the input field that the LinkedIn actor uses for the profile URL list
LINKEDIN_URL_FIELD=profileUrls

# --- Dating engine ---
DATE_CONCURRENCY=4
DATA_FILE=./data/db.json
